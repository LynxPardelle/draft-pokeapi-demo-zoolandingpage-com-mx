      "type": "text",
      "config": {
        "tag": "h2",
        "text": "El mismo patron sirve para blogs, catalogos y productos",
        "classes": "pokeSectionTitle"
      }
    },
    {
      "id": "detailRuntimeText",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "En otro proyecto, el parametro podria ser un slug de articulo, un SKU o un ID publico. La configuracion del draft mantiene la vista editable y el proxy conserva los controles de seguridad.",
        "classes": "pokeSectionText"
      }
    },
