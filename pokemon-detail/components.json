        "classes": "detailHeroBand",
        "components": [
          "pokeDetailHeroInner"
        ]
      },
      "condition": "all:varEq,remoteStatus.pokemon.selected.state,success; all:varLenGt,remote.pokemon.selected.items,0",
      "valueInstructions": "set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeSurfaceStyles,__missing__"
    },
    {
      "id": "pokeDetailHeroInner",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "pokeDetailHeroInner",
        "components": [
          "detailHeroCopy",
          "pokeDetailHeroVisual"
        ]
      }
    },
    {
      "id": "detailHeroCopy",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "detailHeroCopy",
        "components": [
          "detailKicker",
          "detailTitle",
          "detailIntro",
          "detailTypeRow",
          "detailPrimaryAction"
        ]
      }
    },
    {
      "id": "detailKicker",
      "type": "text",
      "valueInstructions": "set:config.text,varOr,remote.pokemon.selected.items.0.number,#25; set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeOutlineStyles,__missing__",
      "config": {
        "tag": "p",
        "text": "#25",
        "classes": "heroKicker"
      }
    },
    {
      "id": "detailTitle",
      "type": "text",
      "valueInstructions": "set:config.text,varOr,remote.pokemon.selected.items.0.name,pikachu",
      "config": {
        "tag": "h1",
        "text": "pikachu",
        "classes": "detailTitle"
      }
    },
    {
      "id": "detailIntro",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Esta ficha usa una ruta parametrizada y consulta PokeAPI con el nombre recibido en la URL. El draft define la plantilla visual, el proxy controla la URL real y los campos permitidos.",
        "classes": "heroText"
      }
    },
    {
      "id": "detailTypeRow",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "detailTypeRow",
        "components": [
          "detailTypeChip",
          "detailAbilityChip"
        ]
      }
    },
    {
      "id": "detailTypeChip",
      "type": "text",
      "valueInstructions": "set:config.text,varOr,remote.pokemon.selected.items.0.primaryTypeLabel,Electric; set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeBadgeStyles,__missing__",
      "config": {
        "tag": "p",
        "text": "electric",
        "classes": "heroChip"
      }
    },
    {
      "id": "detailAbilityChip",
      "type": "text",
      "valueInstructions": "set:config.text,varOr,remote.pokemon.selected.items.0.abilityLabel,Static; set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeOutlineStyles,__missing__",
      "config": {
        "tag": "p",
        "text": "static",
        "classes": "detailAbilityChip"
      }
    },
    {
      "id": "detailPrimaryAction",
      "type": "link",
      "valueInstructions": "set:config.href,varOr,remote.pokemon.selected.items.0.apiHref,https://pokeapi.co/api/v2/pokemon/pikachu/; set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeActionStyles,__missing__",
      "config": {
        "href": "https://pokeapi.co/api/v2/pokemon/pikachu/",
        "text": "Ver respuesta original",
        "target": "_blank",
        "rel": "noopener noreferrer",
        "classes": "primaryAction"
      }
    },
    {
      "id": "pokeDetailHeroVisual",
      "type": "container",
      "config": {
        "tag": "aside",
        "ariaLabel": "Arte oficial del Pokemon seleccionado",
        "classes": "pokeDetailHeroVisual",
        "components": [
          "detailPokemonImage",
          "detailImageCaption"
        ]
      }
    },
    {
      "id": "detailPokemonImage",
      "type": "media",
      "valueInstructions": "set:config.src,varOr,remote.pokemon.selected.items.0.image,https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png; set:config.alt,varOr,remote.pokemon.selected.items.0.name,pikachu",
      "config": {
        "tag": "image",
        "src": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png",
        "alt": "pikachu",
        "width": 475,
        "height": 475,
        "loading": "eager",
        "fetchPriority": "high",
        "decoding": "async",
        "sizes": "(min-width: 1024px) 380px, 82vw",
        "classes": "pokeDetailImage"
      }
    },
    {
      "id": "detailImageCaption",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Arte oficial desde PokeAPI",
        "classes": "pokeDetailStatusPill"
