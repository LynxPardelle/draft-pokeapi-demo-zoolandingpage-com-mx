{
  "version": 1,
  "domain": "pokeapi-demo.zoolandingpage.com.mx",
  "pageId": "pokemon-detail",
  "components": [
    {
      "id": "skipToMainLink",
      "type": "link",
      "eventInstructions": "skipToMain:pokemon-detail-main",
      "config": {
        "id": "skipToMainLink",
        "href": "#pokemon-detail-main",
        "text": "Saltar al contenido principal",
        "ariaLabel": "Saltar al contenido principal",
        "classes": "ank-d-none"
      }
    },
    {
      "id": "detailPage",
      "type": "container",
      "config": {
        "id": "pokemon-detail-main",
        "tag": "main",
        "classes": "demoPage detailPage",
        "components": [
          "detailTopBar",
          "detailSkeletonSection",
          "detailHeroSection",
          "detailStatsSection",
          "detailMovesSection",
          "detailRuntimeSection",
          "demoFooter"
        ]
      },
      "valueInstructions": "set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeVars"
    },
    {
      "id": "detailTopBar",
      "type": "container",
      "config": {
        "tag": "nav",
        "ariaLabel": "Navegacion de la demo",
        "classes": "detailTopBar",
        "components": [
          "detailBackLink",
          "detailTopSearch",
          "detailThemeToggle"
        ]
      },
      "valueInstructions": "set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeSurfaceStyles,__missing__"
    },
    {
      "id": "detailBackLink",
      "type": "link",
      "config": {
        "href": "/",
        "text": "Volver al catalogo",
        "classes": "secondaryAction"
      },
      "valueInstructions": "set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeOutlineStyles,__missing__"
    },
    {
      "id": "detailTopSearch",
      "type": "search-box",
      "valueInstructions": "set:config.suggestions,varOr,remote.pokemon.index.items,config.suggestions",
      "eventInstructions": "navigateToUrl:event.eventData.href,_self,top",
      "config": {
        "minLength": 1,
        "debounceMs": 80,
        "ariaLabel": "Buscar otro Pokemon",
        "placeholder": "Buscar otro Pokemon",
        "classes": "detailSearch",
        "inputClasses": "pokemonSearchInput",
        "resultsClasses": "pokemonSearchResults",
        "resultItemClasses": "pokemonSearchResult",
        "statusItemClasses": "pokemonSearchStatus",
        "maxResults": 8,
        "suggestions": [
          {
            "id": "pikachu",
            "label": "pikachu",
            "description": "Ficha dinamica de pikachu",
            "href": "/pokemon?name=pikachu"
          },
          {
            "id": "eevee",
            "label": "eevee",
            "description": "Ficha dinamica de eevee",
            "href": "/pokemon?name=eevee"
          },
          {
            "id": "charizard",
            "label": "charizard",
            "description": "Ficha dinamica de charizard",
            "href": "/pokemon?name=charizard"
          },
          {
            "id": "gengar",
            "label": "gengar",
            "description": "Ficha dinamica de gengar",
            "href": "/pokemon?name=gengar"
          },
          {
            "id": "bulbasaur",
            "label": "bulbasaur",
            "description": "Ficha dinamica de bulbasaur",
            "href": "/pokemon?name=bulbasaur"
          },
          {
            "id": "squirtle",
            "label": "squirtle",
            "description": "Ficha dinamica de squirtle",
            "href": "/pokemon?name=squirtle"
          },
          {
            "id": "dragonite",
            "label": "dragonite",
            "description": "Ficha dinamica de dragonite",
            "href": "/pokemon?name=dragonite"
          },
          {
            "id": "lucario",
            "label": "lucario",
            "description": "Ficha dinamica de lucario",
            "href": "/pokemon?name=lucario"
          }
        ]
      }
    },
    {
      "id": "detailThemeToggle",
      "type": "button",
      "eventInstructions": "toggleTheme",
      "config": {
        "type": "button",
        "label": "Tema",
        "icon": "dark_mode",
        "iconPosition": "before",
        "ariaLabel": "Alternar tema claro y oscuro",
        "classes": "themeAction"
      },
      "valueInstructions": "set:config.icon,themePick,dark_mode,light_mode; set:config.styles,varOr,remote.pokemon.selected.items.0.typeThemeOutlineStyles,__missing__"
    },
    {
      "id": "detailHeroSection",
